<Window x:Class="CustomStereoMix.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Custom Stereo Mix" Icon="Assets/AppIcon.ico" Width="760" Height="730"
 MinWidth="620" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F5F7FB">
 <Grid>
  <web:WebView2 x:Name="Browser" DefaultBackgroundColor="#F5F7FB" />
  <Border x:Name="StartupPanel" Background="#F5F7FB" Padding="28">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
    <TextBlock Text="Custom Stereo Mix" FontSize="24" FontWeight="SemiBold" Foreground="#202B40" />
    <TextBlock x:Name="StartupMessage" TextWrapping="Wrap" Margin="0,16,0,12" Foreground="#526079" FontSize="14" />
    <Button x:Name="RetryButton" Click="RetryStartup" Visibility="Collapsed" Padding="14,8" Margin="0,0,0,8" />
    <Button x:Name="RuntimeButton" Click="OpenRuntimeWebsite" Visibility="Collapsed" Padding="14,8" />
   </StackPanel>
  </Border>
 </Grid>
</Window>
