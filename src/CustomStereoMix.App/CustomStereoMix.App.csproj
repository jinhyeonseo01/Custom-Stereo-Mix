<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CustomStereoMix.Core\CustomStereoMix.Core.csproj" />
    <ProjectReference Include="..\CustomStereoMix.Audio\CustomStereoMix.Audio.csproj" />
    <ProjectReference Include="..\CustomStereoMix.State\CustomStereoMix.State.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <FrontendInputs Include="..\..\ui\src\**\*;..\..\ui\public\**\*;..\..\ui\index.html;..\..\ui\package.json;..\..\ui\package-lock.json;..\..\ui\tsconfig.json;..\..\ui\vite.config.ts" />
  </ItemGroup>
  <Target Name="RestoreFrontend" BeforeTargets="BuildFrontend" Inputs="..\..\ui\package-lock.json" Outputs="..\..\ui\node_modules\.package-lock.json">
    <Exec WorkingDirectory="..\..\ui" Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild" Inputs="@(FrontendInputs)" Outputs="..\..\ui\dist\index.html">
    <Exec WorkingDirectory="..\..\ui" Command="npm run build" />
  </Target>
  <Target Name="IncludeFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFrontend">
    <ItemGroup>
      <FrontendAsset Include="..\..\ui\dist\**\*" />
      <Content Include="@(FrontendAsset)">
        <Link>wwwroot\%(FrontendAsset.RecursiveDir)%(FrontendAsset.Filename)%(FrontendAsset.Extension)</Link>
        <TargetPath>wwwroot\%(FrontendAsset.RecursiveDir)%(FrontendAsset.Filename)%(FrontendAsset.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
